
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load dataset
url = "https://raw.githubusercontent.com/plotly/datasets/master/StudentsPerformance.csv"

df = pd.read_csv(url)

print("Dataset loaded successfully!")
display(df.head())

# Dataset information
df.info()

print("Dataset Shape:", df.shape)

display(df.describe())

# Check missing values
print("Missing values before cleaning:")
print(df.isnull().sum())

# Fill missing numerical values with median
for col in ['math score', 'reading score', 'writing score']:
    df[col] = df[col].fillna(df[col].median())

# Fill missing categorical values with mode
for col in ['gender', 'race/ethnicity',
            'parental level of education',
            'lunch', 'test preparation course']:
    df[col] = df[col].fillna(df[col].mode()[0])

print("Missing values after cleaning:")
print(df.isnull().sum())

# Statistical analysis
print("Total Students:", len(df))

print("Average Math Score:",
      round(df['math score'].mean(), 2))

print("Average Reading Score:",
      round(df['reading score'].mean(), 2))

print("Average Writing Score:",
      round(df['writing score'].mean(), 2))

print("Overall Average Score:",
      round(df[['math score', 'reading score',
                'writing score']].mean().mean(), 2))

# 1. Student count by gender
plt.figure(figsize=(7, 5))
sns.countplot(data=df, x='gender')
plt.title('Student Count by Gender')
plt.xlabel('Gender')
plt.ylabel('Number of Students')
plt.show()

# 2. Math score distribution
plt.figure(figsize=(7, 5))
sns.histplot(data=df, x='math score', bins=15, kde=True)
plt.title('Math Score Distribution')
plt.xlabel('Math Score')
plt.ylabel('Number of Students')
plt.show()

# 3. Scores by gender
df_melted = df.melt(
    id_vars='gender',
    value_vars=['math score', 'reading score', 'writing score'],
    var_name='Subject',
    value_name='Score'
)

plt.figure(figsize=(8, 5))
sns.barplot(data=df_melted, x='Subject',
            y='Score', hue='gender')
plt.title('Average Scores by Gender')
plt.xlabel('Subject')
plt.ylabel('Average Score')
plt.show()

# 4. Test preparation and math scores
plt.figure(figsize=(8, 5))
sns.boxplot(data=df, x='test preparation course',
            y='math score')
plt.title('Math Scores by Test Preparation')
plt.xlabel('Test Preparation Course')
plt.ylabel('Math Score')
plt.show()

# 5. Correlation between subject scores
plt.figure(figsize=(7, 5))
sns.heatmap(
    df[['math score', 'reading score',
        'writing score']].corr(),
    annot=True,
    cmap='coolwarm'
)
plt.title('Correlation Between Subject Scores')
plt.show()

# Export cleaned dataset
df.to_excel('student_performance_cleaned.xlsx',
            index=False)

print("Cleaned dataset exported successfully!")
